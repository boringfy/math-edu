{
  "expo": {
    "name": "Have Fun Learning",
    "slug": "math-edu",
    "scheme": "havefunlearning",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://math-edu.hashfront.com/v1/app-updates/manifest",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "requestHeaders": {
        "expo-channel-name": "production"
      },
      "codeSigningCertificate": "./updates/certificate.pem",
      "codeSigningMetadata": {
        "keyid": "main",
        "alg": "rsa-v1_5-sha256"
      }
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "appleTeamId": "FNK34ANN2H",
      "bundleIdentifier": "com.hashfront.mathedu",
      "buildNumber": "1",
      "entitlements": {
        "com.apple.developer.ubiquity-kvstore-identifier": "$(TeamIdentifierPrefix)com.hashfront.mathedu"
      }
    },
    "android": {
      "package": "com.hashfront.mathedu",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#16C9EC",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Have Fun Learning listens while you read a story out loud, so it can light up the words it hears.",
          "speechRecognitionPermission": "Have Fun Learning checks which words you read out loud during reading practice.",
          "androidSpeechServicePackages": [
            "com.google.android.tts",
            "com.google.android.as",
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      "./plugins/withPointerEvents",
      "./plugins/withContentCleartext",
      "expo-iap",
      "expo-audio"
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
