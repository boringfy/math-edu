{
  "name": "@math-edu/frontend",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.18",
    "expo-crypto": "~57.0.2",
    "expo-file-system": "~57.0.5",
    "expo-speech": "~57.0.2",
    "expo-speech-recognition": "^56.0.1",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/node": "^22.10.2",
    "@types/react": "~19.2.2",
    "@types/react-test-renderer": "^19.1.0",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "react-test-renderer": "^19.2.3",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "tsc --noEmit && jest",
    "test:ios": "jest --selectProjects ios",
    "test:android": "jest --selectProjects android",
    "test:logic": "jest --selectProjects logic"
  },
  "jest": {
    "projects": [
      {
        "displayName": "logic",
        "preset": "jest-expo/ios",
        "rootDir": ".",
        "testMatch": [
          "<rootDir>/src/lib/__tests__/**/*.test.ts?(x)",
          "<rootDir>/src/content/__tests__/**/*.test.ts?(x)"
        ]
      },
      {
        "displayName": "ios",
        "preset": "jest-expo/ios",
        "rootDir": ".",
        "testMatch": [
          "<rootDir>/src/screens/__tests__/**/*.test.ts?(x)",
          "<rootDir>/src/components/__tests__/**/*.test.ts?(x)",
          "<rootDir>/src/__tests__/**/*.test.ts?(x)"
        ]
      },
      {
        "displayName": "android",
        "preset": "jest-expo/android",
        "rootDir": ".",
        "testMatch": [
          "<rootDir>/src/screens/__tests__/**/*.test.ts?(x)",
          "<rootDir>/src/components/__tests__/**/*.test.ts?(x)",
          "<rootDir>/src/__tests__/**/*.test.ts?(x)"
        ]
      },
      {
        "displayName": "plugins",
        "preset": "jest-expo/node",
        "rootDir": ".",
        "testMatch": [
          "<rootDir>/plugins/__tests__/**/*.test.js"
        ]
      }
    ]
  },
  "private": true
}
