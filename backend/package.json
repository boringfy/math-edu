{
  "name": "@math-edu/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Bakes Boring Quest's content into versioned packs and serves them",
  "scripts": {
    "bake": "tsx src/bake/bake.ts",
    "seed": "tsx src/bake/seed.ts",
    "sync:contract": "tsx src/bake/syncContract.ts",
    "serve": "tsx src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx src/bake/syncContract.ts --check && tsc --noEmit && vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "hono": "^4.6.14",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "~6.0.3",
    "vitest": "^2.1.8"
  }
}
