# The AI tutor's language model. Copy to backend/.env (gitignored) and fill in.
# Any OpenAI-compatible chat-completions provider works; all three must be set
# or the /v1/explain endpoint answers 503 and the app hides its help button.
TUTOR_LLM_URL=https://api.neoskycloud.com/v1/chat/completions
TUTOR_LLM_KEY=
TUTOR_LLM_MODEL=qwen3.8-27b
# Optional JSON merged into every request body — the home for provider-specific
# tuning. This one turns the current model's hidden reasoning off entirely,
# which is most of a child's wait (a lesson that took ~60s takes ~10s).
TUTOR_LLM_EXTRA={"chat_template_kwargs":{"enable_thinking":false}}
# Optional, softer fallback for Qwen models with no real switch: prefixes the
# prompt with /no_think, which shrinks the reasoning rather than removing it.
#TUTOR_LLM_NO_THINK=1

# Standby models, tried in order when the one above cannot answer — a rate
# limit, an outage, a model retired from under us, or a reply that parses to
# nothing. A child stuck on a question is the worst moment to have nothing to
# say, so it is worth naming at least one.
#
# A fallback inherits anything it does not set from the primary, so a second
# model on the same provider is one line. Point one at a different vendor and
# it needs its own URL and key — and probably its own EXTRA, since that tuning
# is written in the first provider's dialect.
#TUTOR_LLM_2_MODEL=qwen3.8-7b
#TUTOR_LLM_3_URL=https://api.other.example.com/v1/chat/completions
#TUTOR_LLM_3_KEY=
#TUTOR_LLM_3_MODEL=
#TUTOR_LLM_3_EXTRA={}

# How long a child waits in total, across every model above — adding a
# fallback divides this rather than doubling the wait. The app gives up at
# 130s, so anything past that is the app's timeout talking, not this one.
#TUTOR_LLM_TIMEOUT_MS=120000

# Progress sync. Unset means every sync route answers 503 and the app keeps
# everything on the device, exactly as before. docker-compose sets this to a
# file on a mounted volume; for a bare `npm run serve`, any writable path.
#SYNC_DB_PATH=./data/sync.db

# Google account linking, for carrying progress to a new device. The app's
# OAuth client ids (web, Android, iOS), comma-separated; unset means the link
# route answers 503 and the app hides its button.
#GOOGLE_CLIENT_IDS=
