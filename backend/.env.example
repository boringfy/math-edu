# The AI tutor's language model. Copy to backend/.env (gitignored) and fill in.
# Any OpenAI-compatible chat-completions provider works; all three must be set
# or the /v1/explain endpoint answers 503 and the app hides its help button.
TUTOR_LLM_URL=https://api.neoskycloud.com/v1/chat/completions
TUTOR_LLM_KEY=
TUTOR_LLM_MODEL=qwen3.8-27b
# Optional JSON merged into every request body — the home for provider-specific
# tuning. This one turns the current model's hidden reasoning off entirely,
# which is most of a child's wait (a lesson that took ~60s takes ~10s).
TUTOR_LLM_EXTRA={"chat_template_kwargs":{"enable_thinking":false}}
# Optional, softer fallback for Qwen models with no real switch: prefixes the
# prompt with /no_think, which shrinks the reasoning rather than removing it.
#TUTOR_LLM_NO_THINK=1
