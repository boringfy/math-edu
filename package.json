{
  "name": "math-edu",
  "version": "1.0.0",
  "private": true,
  "description": "Boring Quest — an Expo app for grades 1-5, and the backend that serves its content",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "start": "npm run start -w frontend",
    "android": "npm run android -w frontend",
    "ios": "npm run ios -w frontend",
    "web": "npm run web -w frontend",
    "bake": "npm run bake -w backend",
    "serve": "npm run serve -w backend",
    "sync:contract": "npm run sync:contract -w backend",
    "test": "npm test --workspaces --if-present"
  }
}
