{
  "expo": {
    "name": "Boring Quest",
    "slug": "math-edu",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.boringfy.mathedu",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Boring Quest listens while you read a story out loud, so it can light up the words it hears. Everything stays on this device.",
          "speechRecognitionPermission": "Boring Quest checks which words you read out loud, entirely on this device.",
          "androidSpeechServicePackages": [
            "com.google.android.tts",
            "com.google.android.as",
            "com.google.android.googlequicksearchbox"
          ]
        }
      ]
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
